{
  "name": "rescript-base-xote",
  "namespace": "base-xote",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "jsx": {
    "version": 4,
    "module": "XoteJSX"
  },
  "ppx-flags": [
    "xote/ppx/ppx"
  ],
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.mjs",
  "dependencies": [
    "xote"
  ],
  "compiler-flags": [
    "-open Xote"
  ]
}
